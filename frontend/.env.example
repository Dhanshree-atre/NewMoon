# PrivateAirdrop frontend configuration.
#
# Copy to .env.local and adjust. All values are PUBLIC (served to the browser)
# — never put secrets here.

# Midnight network to connect the wallet to: 'preview' | 'preprod' | 'undeployed'
# Must match the network selected in your 1AM (Midnight Lace) wallet.
VITE_NETWORK_ID=preprod

# A deployed PrivateAirdrop campaign contract address (hex). Leave empty to
# create a new campaign from the Admin panel.
# The reference preprod deployment:
VITE_CONTRACT_ADDRESS=806413b7436003e625699f9166c49ec7eb783ea671a899542edc20530d2f3e1e

# Override the indexer used for PUBLIC ledger reads (optional — normally the
# wallet connector reports the network's indexer automatically).
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
